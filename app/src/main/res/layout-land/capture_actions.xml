<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:baselineAligned="false">
        <Chronometer android:id="@+id/recordingClock" android:layout_width="64dp" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="16sp" android:contentDescription="@string/recording_time" />
        <Button android:id="@+id/record" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp"
            android:text="@string/start_recording" android:backgroundTint="#ED8589" android:textColor="#180C0D" android:enabled="false" />
    </LinearLayout>
    <Button android:id="@+id/openControls" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/open_controls" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:baselineAligned="false">
        <Button android:id="@+id/modeDetails" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/mode_details" android:contentDescription="@string/mode_details_description" />
        <Button android:id="@+id/testMode" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/test_mode" android:contentDescription="@string/test_mode_description" android:enabled="false" />
        <Button android:id="@+id/previewAids" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/preview_aids_button" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:text="@string/capture_scope_short" android:textSize="11sp" android:letterSpacing="0.08" android:textColor="#BDC5D1" />
</LinearLayout>
