<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="8dp" android:background="#171E29">
    <Spinner android:id="@+id/cameraSelector" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/camera_label" />
    <Spinner android:id="@+id/modeSelector" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/mode_label" />
    <include layout="@layout/audio_controls" />
    <TextView android:id="@+id/resourceStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/resource_idle" android:textSize="11sp" android:textColor="#B6C5DB" android:maxLines="2" />
    <TextView android:id="@+id/colourStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/colour_direct" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textColor="#C7D8FF" />
    <TextView android:id="@+id/modeEvidence" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/advertised_only" android:textSize="11sp" android:textColor="#B6C5DB" android:maxLines="2" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
        <Chronometer android:id="@+id/recordingClock" android:layout_width="64dp" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="16sp" android:contentDescription="@string/recording_time" />
        <Button android:id="@+id/record" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
            android:text="@string/start_recording" android:backgroundTint="#ED8589" android:textColor="#180C0D" android:enabled="false" />
        <Button android:id="@+id/openControls" android:layout_width="wrap_content" android:layout_height="56dp" android:text="@string/open_controls" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp">
        <Button android:id="@+id/modeDetails" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/mode_details" />
        <Button android:id="@+id/testMode" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/test_mode" android:enabled="false" />
        <Button android:id="@+id/previewAids" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/preview_aids_button" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:text="@string/capture_scope_short" android:textSize="10sp" android:letterSpacing="0.08" android:textColor="#BDC5D1" />
</LinearLayout>
