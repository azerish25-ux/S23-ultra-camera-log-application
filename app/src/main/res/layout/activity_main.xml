<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0C1016">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="20sp" android:textStyle="bold" android:textColor="#F4F6FA" />
        <Button android:id="@+id/cameraTab" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/camera_tab" />
        <Button android:id="@+id/diagnosticsTab" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/diagnostics_tab" />
    </LinearLayout>
    <ViewFlipper android:id="@+id/pages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <include layout="@layout/capture_workspace" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/probe_title" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/probe_description" android:textSize="13sp" />
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_ready" android:paddingTop="8dp" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/runProbe" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="@string/run_probe" />
                <Button android:id="@+id/shareReport" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="@string/share_report" android:enabled="false" />
            </LinearLayout>
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
                <TextView android:id="@+id/report" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textSize="12sp" android:textIsSelectable="true" android:text="@string/report_empty" />
            </ScrollView>
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>
