          "unit": "deltaE2000",
          "domain": "chart_reflectance_D65",
          "operator": "le",
          "provisional": true
        },
        "maximumDeltaE2000": {
          "value": 6.0,
          "unit": "deltaE2000",
          "domain": "chart_reflectance_D65",
          "operator": "le",
          "provisional": true
        }
