      "kind": "colour",
      "unit": "deltaE2000",
      "domain": "chart_reflectance_D65",
      "samplingProcedure": "Retain every patch error, chart identity, illuminant, instrument and calibration trace. Unknown illuminant or instrument keeps the result exploratory.",
      "statisticalScope": "All measured patches; no removal of visually inconvenient patches or replacement by mean-only reporting.",
      "uncertaintySources": [
        "illuminant spectrum",
        "instrument calibration",
        "chart ageing",
        "flare",
        "exposure",
        "patch selection",
        "working-space conversion"
