{
  "schemaVersion": 1,
  "phase": "P005",
  "registryId": "s23-cinema-measurements-v1",
  "implementationBaseRevision": "c1386a4b9376403ac70dd35c6609dbe5a2bd5116",
  "scope": "Measurement identity, uncertainty and inference limits. Policies are provisional project gates, not physical S23 certification.",
  "policies": [
    {
      "id": "cadence.sensor-timestamp.v1",
      "version": 1,
      "kind": "cadence",
      "unit": "ns",
      "domain": "sensor_timestamp",
      "samplingProcedure": "Record every sensor timestamp in acquisition order and preserve every adjacent interval. A changing-content protocol supplies one frame identifier per timestamp when content integrity is claimed.",
      "statisticalScope": "Complete sequence; no trimming, outlier deletion, resampling or replacement by an aggregate mean.",
      "uncertaintySources": [
        "sensor-clock resolution",
        "timestamp quantization",
        "camera/OS scheduling",
        "content-identifier generation and readout"
      ],
      "thresholds": {
        "nominalFpsToleranceFraction": {
          "value": 0.03,
          "unit": "ratio",
          "domain": "rate_fraction",
          "operator": "le",
          "provisional": true
        },
        "largeGapMultiplier": {
          "value": 1.5,
          "unit": "ratio",
          "domain": "adjacent_interval",
          "operator": "le",
          "provisional": true
        },
        "minimumSpan": {
          "value": 2000000000,
          "unit": "ns",
          "domain": "sensor_timestamp_span",
          "operator": "ge",
          "provisional": true
        }
      },
      "calibration": {
        "required": false,
        "inputs": [
          "timestamp resolution and domain declaration"
        ]
      },
      "supersedes": null,
      "review": null,
      "history": [
        {
          "version": 1,
          "reason": "Initial P005 provisional measurement policy",
          "reviewer": "P005 implementation owner",
          "validationEvidence": [
            "TC-P005-01",
            "TC-P005-04",
            "TC-P005-05",
            "TC-P005-06"
          ]
        }
      ]
    },
    {
      "id": "cadence.muxed-presentation.v1",
      "version": 1,
      "kind": "cadence",
      "unit": "us",
      "domain": "muxed_video_presentation_timestamp",
      "samplingProcedure": "Record every selected video packet presentation timestamp in mux order; retain all intervals and decoder/container context.",
      "statisticalScope": "Complete selected video stream; no dropped packets or aggregate-only substitution when per-frame integrity is claimed.",
      "uncertaintySources": [
        "container time-base quantization",
        "encoder reordering",
        "muxer rounding",
        "packet extraction precision"
      ],
      "thresholds": {
        "nominalFpsToleranceFraction": {
          "value": 0.03,
          "unit": "ratio",
          "domain": "rate_fraction",
          "operator": "le",
          "provisional": true
        },
        "largeGapMultiplier": {
          "value": 1.5,
          "unit": "ratio",
          "domain": "adjacent_interval",
          "operator": "le",
          "provisional": true
        },
        "minimumSpan": {
          "value": 2000000,
          "unit": "us",
          "domain": "muxed_video_presentation_timestamp_span",
          "operator": "ge",
          "provisional": true
        }
      },
      "calibration": {
        "required": false,
        "inputs": [
          "stream index and time base"
        ]
      },
      "supersedes": null,
      "review": null,
      "history": [
        {
          "version": 1,
          "reason": "Initial P005 provisional measurement policy",
          "reviewer": "P005 implementation owner",
          "validationEvidence": [
            "TC-P005-01",
            "TC-P005-04",
            "TC-P005-05",
            "TC-P005-06"
          ]
        }
      ]
    },
    {
      "id": "precision.codec-p010.v1",
      "version": 1,
      "kind": "precision",
      "unit": "code_value",
      "domain": "decoded_P010",
      "samplingProcedure": "Compare every retained decoded ramp sample against its expected ten-bit code value; preserve individual errors and distinguishable decoded levels.",
      "statisticalScope": "At least 600 samples; mean, peak and level count are all retained. This is codec/arithmetic evidence only.",
      "uncertaintySources": [
        "decoder implementation",
        "rounding",
        "limited-range packing",
        "sample generation"
      ],
      "thresholds": {
        "meanCodeError": {
          "value": 0.75,
          "unit": "code_value",
          "domain": "decoded_P010",
          "operator": "le",
          "provisional": true
        },
        "peakCodeError": {
          "value": 2.0,
          "unit": "code_value",
          "domain": "decoded_P010",
          "operator": "le",
          "provisional": true
        },
        "minimumLevels": {
          "value": 600,
          "unit": "count",
          "domain": "decoded_P010_distinguishable_levels",
          "operator": "ge",
          "provisional": true
        }
      },
      "calibration": {
        "required": false,
        "inputs": [
          "expected ramp generation contract"
        ]
      },
      "supersedes": null,
      "review": null,
      "history": [
        {
          "version": 1,
          "reason": "Initial P005 provisional measurement policy",
          "reviewer": "P005 implementation owner",
          "validationEvidence": [
            "TC-P005-01",
            "TC-P005-04",
            "TC-P005-05",
            "TC-P005-06"
          ]
        }
      ]
    },
    {
      "id": "precision.sensor-effective.v1",
      "version": 1,
      "kind": "sensor_precision",
      "unit": "bits",
      "domain": "physical_sensor_signal",
      "samplingProcedure": "Estimate effective sensor precision only from retained physical sensor samples under a documented exposure/noise protocol and calibration trace.",
      "statisticalScope": "No synthetic, emulator, container-bit-depth or decoded-ramp result may substitute for physical sensor samples.",
      "uncertaintySources": [
        "shot noise",
        "read noise",
        "black-level drift",
        "temperature",
        "exposure repeatability",
        "ADC/ISP behavior"
      ],
      "thresholds": {},
      "calibration": {
        "required": true,
        "inputs": [
          "physical S23 identity",
          "retained sensor samples",
          "black/white calibration",
          "exposure protocol",
          "temperature"
        ]
      },
      "supersedes": null,
      "review": null,
      "history": [
        {
          "version": 1,
          "reason": "Initial P005 provisional measurement policy",
          "reviewer": "P005 implementation owner",
          "validationEvidence": [
            "TC-P005-01",
            "TC-P005-04",
            "TC-P005-05",
            "TC-P005-06"
          ]
        }
      ]
    },
    {
